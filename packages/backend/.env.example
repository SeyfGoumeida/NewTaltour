PORT=3001
# development active les outils de démo (seed, lien de réinitialisation affiché, paiements simulés)
NODE_ENV=development

DB_USER=taltour_user
DB_PASSWORD=taltour_password_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newtaltour_dev

# Obligatoire hors développement : au moins 32 caractères aléatoires (openssl rand -hex 32)
JWT_SECRET=

# Adresse exacte du site (https hors développement)
FRONTEND_URL=http://localhost:3000

# Domaine du cookie de session si l'API est sur un sous-domaine (ex. .taltour.com)
COOKIE_DOMAIN=

# Nombre de proxys devant l'API (ex. 1 derrière un load balancer), sinon vide
TRUST_PROXY=

# Paiements CB/PayPal simulés : true par défaut en développement, false ailleurs.
# Ne jamais activer en production tant qu'un prestataire de paiement n'est pas branché.
SIMULATED_PAYMENTS=
